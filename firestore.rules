rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    match /users/{userId} {
      allow read: if true;
      
      // Allow creation if it's their own profile
      allow create: if isAuthenticated() && request.auth.uid == userId 
                    && (request.resource.data.role == "USER" || request.resource.data.role == "OWNER");

      // Allow updates to own profile
      allow update: if isAuthenticated() && request.auth.uid == userId
                    // Cannot change role
                    && request.resource.data.role == resource.data.role
                    // XP and Level can only increase (validated operation)
                    && request.resource.data.xp >= resource.data.xp
                    && request.resource.data.level >= resource.data.level;
    }

    match /petitions_v2/{petitionId} {
      allow read: if true;
      // Anyone authenticated can create a petition
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Allow anyone to update reactions (increment only)
      allow update: if true; 
      allow delete: if false;
    }

    match /polls/{pollId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    match /leaderboards/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /events/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
